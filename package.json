{
  "name": "circuitmaster",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "cargo build --release --target wasm32-unknown-unknown --manifest-path crates/netlist/Cargo.toml && cp crates/netlist/target/wasm32-unknown-unknown/release/netlist.wasm src/core/Netlist/netlist.wasm",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "npm run wasm && vitest run"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "fflate": "0.8.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "4.1.11"
  }
}
